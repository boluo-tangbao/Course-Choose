{"ast":null,"code":"import request from \"@/utils/request\";\nimport WebSocketReconnect from \"@/utils/WebSocketReconnect\";\nexport default {\n  name: \"TeacherChat\",\n\n  created() {\n    //this.getAllTeacherAmount();\n    this.load();\n  },\n\n  data() {\n    return {\n      search: '',\n      tableData: [],\n      total: 0,\n      credit: [],\n      Job_number: []\n    };\n  },\n\n  mounted() {\n    if ('WebSocket' in window) {\n      // 连接WebSocket节点\n      this.websocket = new WebSocketReconnect('ws://127.0.0.1:9090' + '/websocket/123');\n    } else {\n      alert('浏览器不支持webSocket');\n    } // 接收到消息的回调方法\n\n\n    this.websocket.socket.onmessage = function (event) {\n      const data = event.data;\n      console.log('后端传递的数据:' + data); // 将后端传递的数据渲染至页面\n      // textarea1.value = textarea1.value + data + '\\n' + '【消息】---->'\n    }; // 监听窗口关闭事件，当窗口关闭时，主动去关闭websocket连接，防止连接还没断开就关闭窗口，server端会抛异常。\n\n\n    window.onbeforeunload = function () {\n      this.websocket.close();\n    }; // 关闭连接\n\n\n    function closeWebSocket() {\n      this.websocket.close();\n    } // 发送消息\n\n\n    function send() {\n      this.websocket.socket.send({\n        kk: 123\n      });\n    }\n  },\n\n  methods: {\n    load() {\n      request.get(\"/course/forTeacherWithSameCourse\", {\n        params: {\n          search: this.search,\n          teacherId: sessionStorage.getItem(\"currentId\")\n        }\n      }).then(res => {\n        console.log(res);\n        this.tableData = res.data.list;\n        this.total = res.data.total;\n        /*          for (let i = 0; i < this.tableData.length; i++) {\r\n                    for (let j = 0; j < this.credit.length; j++) {\r\n                      if (this.tableData[i].courseId == this.credit[j].id) {\r\n                        this.tableData[i].credit = this.credit[j].credit;\r\n                      }\r\n                    }\r\n                  }*/\n      });\n    },\n\n    /*      goToCheckGrade(row) { //成绩登陆操作\r\n            // 缓存当前课程信息\r\n            sessionStorage.setItem(\"currentCourse\", row.courseNumber);\r\n            sessionStorage.setItem(\"currentCourseName\", row.courseName);\r\n            sessionStorage.setItem(\"currentTerm\", row.term);\r\n            sessionStorage.setItem(\"currentTime\", row.time);\r\n            sessionStorage.setItem(\"currentCredit\", row.credit);\r\n            sessionStorage.setItem(\"currentLimitNum\", row.capacity);\r\n            sessionStorage.setItem(\"currentCurrentNum\", row.curCapacity);\r\n            // 跳转路由\r\n            this.$router.push(\"/teacherGrade\");\r\n          },*/\n    getAllTeacherAmount() {\n      //获取和你同一学期教授同一门课的名单\n      request.get(\"/course/getAllTeacherAmount\").then(res => {\n        console.log(res);\n        this.Job_number = res.data;\n      });\n    }\n\n  }\n};","map":{"version":3,"mappings":"AA0BA,OAAOA,OAAP,MAAoB,iBAApB;AACA,OAAOC,kBAAP,MAA+B,4BAA/B;AACA,eAAc;AACZC,MAAI,EAAE,aADM;;AAEZC,SAAO,GAAG;AACR;AACA,SAAKC,IAAL;AACD,GALW;;AAMZC,MAAI,GAAG;AACL,WAAO;AACLC,YAAM,EAAE,EADH;AAELC,eAAS,EAAE,EAFN;AAGLC,WAAK,EAAE,CAHF;AAILC,YAAM,EAAE,EAJH;AAKLC,gBAAU,EAAC;AALN,KAAP;AAOD,GAdW;;AAeZC,SAAM,GAAK;AACT,QAAI,eAAeC,MAAnB,EAA2B;AACzB;AACA,WAAKC,SAAL,GAAiB,IAAIZ,kBAAJ,CAAuB,wBAAwB,gBAA/C,CAAjB;AACF,KAHA,MAGO;AACLa,WAAK,CAAC,iBAAD,CAAL;AACF,KANS,CAQT;;;AACA,SAAKD,SAAL,CAAeE,MAAf,CAAsBC,SAAtB,GAAkC,UAAUC,KAAV,EAAiB;AACjD,YAAMZ,IAAG,GAAIY,KAAK,CAACZ,IAAnB;AACAa,aAAO,CAACC,GAAR,CAAY,aAAad,IAAzB,EAFiD,CAGjD;AACA;AACF,KALA,CATS,CAeT;;;AACAO,UAAM,CAACQ,cAAP,GAAwB,YAAY;AAClC,WAAKP,SAAL,CAAeQ,KAAf;AACF,KAFA,CAhBS,CAmBT;;;AACA,aAASC,cAAT,GAA2B;AACzB,WAAKT,SAAL,CAAeQ,KAAf;AACF,KAtBS,CAuBT;;;AACA,aAASE,IAAT,GAAiB;AACf,WAAKV,SAAL,CAAeE,MAAf,CAAsBQ,IAAtB,CAA2B;AAAEC,UAAE,EAAE;AAAN,OAA3B;AACF;AACD,GA1CW;;AA2CZC,SAAO,EAAE;AACLrB,QAAI,GAAG;AACLJ,aAAO,CAAC0B,GAAR,CAAY,kCAAZ,EAAgD;AAC9CC,cAAM,EAAE;AACNrB,gBAAM,EAAE,KAAKA,MADP;AAENsB,mBAAS,EAAEC,cAAc,CAACC,OAAf,CAAuB,WAAvB;AAFL;AADsC,OAAhD,EAKGC,IALH,CAKQC,GAAE,IAAK;AACbd,eAAO,CAACC,GAAR,CAAYa,GAAZ;AACA,aAAKzB,SAAL,GAAiByB,GAAG,CAAC3B,IAAJ,CAAS4B,IAA1B;AACA,aAAKzB,KAAL,GAAawB,GAAG,CAAC3B,IAAJ,CAASG,KAAtB;AACV;;;;;;;AAOS,OAhBD;AAiBD,KAnBI;;AAoBX;;;;;;;;;;;;AAYM0B,uBAAmB,GAAG;AAAG;AACvBlC,aAAO,CAAC0B,GAAR,CAAY,6BAAZ,EAA2CK,IAA3C,CAAgDC,GAAE,IAAK;AACrDd,eAAO,CAACC,GAAR,CAAYa,GAAZ;AACA,aAAKtB,UAAL,GAAkBsB,GAAG,CAAC3B,IAAtB;AACD,OAHD;AAIF;;AArCK;AA3CG,CAAd","names":["request","WebSocketReconnect","name","created","load","data","search","tableData","total","credit","Job_number","mounted","window","websocket","alert","socket","onmessage","event","console","log","onbeforeunload","close","closeWebSocket","send","kk","methods","get","params","teacherId","sessionStorage","getItem","then","res","list","getAllTeacherAmount"],"sourceRoot":"","sources":["D:\\大学\\大三\\大三春\\数据库\\My-CourseChoose\\Course-Choose\\frontend-platform\\src\\views\\TeacherChat.vue"],"sourcesContent":["<template>\r\n  <div style=\"padding: 10px;\">\r\n\r\n    <div style=\"margin: 10px 0;\">\r\n      <el-input v-model=\"search\" placeholder=\"请输入关键字\" style=\"width: 30%;\" clearable/>\r\n      <el-button type=\"primary\" style=\"margin-left: 5px;\" @click=\"load\">查询</el-button>\r\n    </div>\r\n\r\n    <el-table :data=\"tableData\" border stripe style=\"width: 100%;\">\r\n      <el-table-column prop=\"courseNumber\" label=\"课程号\"/>\r\n      <el-table-column prop=\"term\" label=\"学期\" sortable/>\r\n      <el-table-column prop=\"courseName\" label=\"课名\" sortable/>\r\n      <el-table-column prop=\"credit\" label=\"学分\"/>\r\n      <el-table-column prop=\"TeacherAmount\" label=\" 当前人数\"/>\r\n\r\n      <el-table-column fixed=\"right\" label=\"操作\" width=\"120\">\r\n        <template #default=\"scope\">\r\n          <el-button type=\"primary\" plain size=\"small\" @click=\"getAllTeacherAmount(scope.row)\">成绩登入</el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n    <div style=\"margin: 10px 10px 10px; font-size: 10px; color: rgb(96, 98, 102);\">共 {{ total }} 条</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\nimport WebSocketReconnect from \"@/utils/WebSocketReconnect\";\r\nexport default{\r\n  name: \"TeacherChat\",\r\n  created() {\r\n    //this.getAllTeacherAmount();\r\n    this.load();\r\n  },\r\n  data() {\r\n    return {\r\n      search: '',\r\n      tableData: [],\r\n      total: 0,\r\n      credit: [],\r\n      Job_number:[]\r\n    }\r\n  },\r\n  mounted () {\r\n    if ('WebSocket' in window) {\r\n      // 连接WebSocket节点\r\n      this.websocket = new WebSocketReconnect('ws://127.0.0.1:9090' + '/websocket/123')\r\n    } else {\r\n      alert('浏览器不支持webSocket')\r\n    }\r\n\r\n    // 接收到消息的回调方法\r\n    this.websocket.socket.onmessage = function (event) {\r\n      const data = event.data\r\n      console.log('后端传递的数据:' + data)\r\n      // 将后端传递的数据渲染至页面\r\n      // textarea1.value = textarea1.value + data + '\\n' + '【消息】---->'\r\n    }\r\n    // 监听窗口关闭事件，当窗口关闭时，主动去关闭websocket连接，防止连接还没断开就关闭窗口，server端会抛异常。\r\n    window.onbeforeunload = function () {\r\n      this.websocket.close()\r\n    }\r\n    // 关闭连接\r\n    function closeWebSocket () {\r\n      this.websocket.close()\r\n    }\r\n    // 发送消息\r\n    function send () {\r\n      this.websocket.socket.send({ kk: 123 })\r\n    }\r\n  },\r\n  methods: {\r\n      load() {\r\n        request.get(\"/course/forTeacherWithSameCourse\", {\r\n          params: {\r\n            search: this.search,\r\n            teacherId: sessionStorage.getItem(\"currentId\")\r\n          }\r\n        }).then(res => {\r\n          console.log(res)\r\n          this.tableData = res.data.list;\r\n          this.total = res.data.total;\r\n/*          for (let i = 0; i < this.tableData.length; i++) {\r\n            for (let j = 0; j < this.credit.length; j++) {\r\n              if (this.tableData[i].courseId == this.credit[j].id) {\r\n                this.tableData[i].credit = this.credit[j].credit;\r\n              }\r\n            }\r\n          }*/\r\n        })\r\n      },\r\n/*      goToCheckGrade(row) { //成绩登陆操作\r\n        // 缓存当前课程信息\r\n        sessionStorage.setItem(\"currentCourse\", row.courseNumber);\r\n        sessionStorage.setItem(\"currentCourseName\", row.courseName);\r\n        sessionStorage.setItem(\"currentTerm\", row.term);\r\n        sessionStorage.setItem(\"currentTime\", row.time);\r\n        sessionStorage.setItem(\"currentCredit\", row.credit);\r\n        sessionStorage.setItem(\"currentLimitNum\", row.capacity);\r\n        sessionStorage.setItem(\"currentCurrentNum\", row.curCapacity);\r\n        // 跳转路由\r\n        this.$router.push(\"/teacherGrade\");\r\n      },*/\r\n      getAllTeacherAmount() {  //获取和你同一学期教授同一门课的名单\r\n        request.get(\"/course/getAllTeacherAmount\").then(res => {\r\n          console.log(res);\r\n          this.Job_number = res.data;\r\n        })\r\n      }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"]},"metadata":{},"sourceType":"module"}