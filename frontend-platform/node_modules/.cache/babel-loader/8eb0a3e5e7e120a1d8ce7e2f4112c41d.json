{"ast":null,"code":"import request from \"@/utils/request\";\nexport default {\n  mounted() {\n    this.getOnlineUsers();\n    setInterval(() => {\n      this.getOnlineUsers();\n    }, 5000);\n  },\n\n  data() {\n    return {\n      showChatRoom: false,\n      // 控制聊天界面显示\n      chatMessages: [],\n      // 存储聊天消息\n      newMessage: '' // 输入的新消息\n\n    };\n  },\n\n  props: {\n    teacherInfo: {\n      //这里存储了当前登录的老师工号，可以从中获取，开启聊天功能\n      type: Array,\n      default: () => []\n    },\n    onlineUserList: {\n      type: Array,\n      default: () => []\n    }\n  },\n  computed: {\n    currentTeacherJobNumber() {\n      return sessionStorage.getItem(\"currentId\");\n    }\n\n  },\n  methods: {\n    getOnlineUsers() {\n      request.get(\"/course/onlineUsers\").then(res => {\n        console.log(res);\n        this.onlineUserList = res.data.list;\n      });\n    },\n\n    close() {\n      this.$emit('close');\n    },\n\n    // 处理按钮点击事件\n    handleButtonClick(index) {\n      const selectedTeacher = this.teacherInfo[index];\n      const selectedTeacherJobNumber = selectedTeacher.jobNumber; // 确定聊天室的唯一标识\n\n      const chatRoomId = `${selectedTeacherJobNumber}-${this.currentTeacherJobNumber}`; // 发送创建聊天室的请求\n\n      request.post(\"/createChatRoom\", {\n        roomId: chatRoomId\n      }).then(response => {\n        if (response.data.success) {\n          // 显示聊天界面\n          this.showChatRoom = true;\n        } else {\n          this.$message.error(response.data.message);\n        }\n      }).catch(error => {\n        console.error(\"创建聊天室失败：\", error);\n        this.$message.error(\"创建聊天室失败，请稍后重试\");\n      });\n    },\n\n    sendMessage() {\n      // 发送消息到后端\n      request.post(\"/sendChatMessage\", {\n        message: this.newMessage\n      }).then(response => {\n        // 发送成功后，将消息添加到消息列表中\n        this.chatMessages.push(this.newMessage); // 清空输入框\n\n        this.newMessage = '';\n      }).catch(error => {\n        console.error(\"发送消息失败：\", error);\n      });\n    },\n\n    isTeacherOnline() {\n      return jobNumber => {\n        return this.onlineUserList.includes(jobNumber);\n      };\n    }\n\n  }\n};","map":{"version":3,"mappings":"AAiCA,OAAOA,OAAP,MAAoB,iBAApB;AAEA,eAAe;AACbC,SAAO,GAAG;AACR,SAAKC,cAAL;AACAC,eAAW,CAAC,MAAM;AAChB,WAAKD,cAAL;AACD,KAFU,EAER,IAFQ,CAAX;AAGD,GANY;;AAObE,MAAI,GAAG;AACL,WAAO;AACLC,kBAAY,EAAE,KADT;AACgB;AACrBC,kBAAY,EAAE,EAFT;AAEa;AAClBC,gBAAU,EAAE,EAHP,CAGW;;AAHX,KAAP;AAKD,GAbY;;AAcbC,OAAK,EAAE;AACLC,eAAW,EAAE;AAAC;AACZC,UAAI,EAAEC,KADK;AAEXC,aAAO,EAAE,MAAM;AAFJ,KADR;AAKLC,kBAAc,EAAE;AACdH,UAAI,EAAEC,KADQ;AAEdC,aAAO,EAAE,MAAM;AAFD;AALX,GAdM;AAwBbE,UAAQ,EAAE;AACRC,2BAAuB,GAAG;AACxB,aAAOC,cAAc,CAACC,OAAf,CAAuB,WAAvB,CAAP;AACF;;AAHQ,GAxBG;AA6BbC,SAAO,EAAE;AACPhB,kBAAc,GAAE;AACdF,aAAO,CAACmB,GAAR,CAAY,qBAAZ,EAAmCC,IAAnC,CAAwCC,GAAE,IAAK;AAC7CC,eAAO,CAACC,GAAR,CAAYF,GAAZ;AACA,aAAKR,cAAL,GAAsBQ,GAAG,CAACjB,IAAJ,CAASoB,IAA/B;AACD,OAHD;AAID,KANM;;AAOPC,SAAK,GAAG;AACN,WAAKC,KAAL,CAAW,OAAX;AACD,KATM;;AAUX;AACIC,qBAAiB,CAACC,KAAD,EAAQ;AACvB,YAAMC,eAAc,GAAI,KAAKpB,WAAL,CAAiBmB,KAAjB,CAAxB;AACA,YAAME,wBAAuB,GAAID,eAAe,CAACE,SAAjD,CAFuB,CAIvB;;AACA,YAAMC,UAAS,GAAK,GAAEF,wBAAyB,IAAG,KAAKf,uBAAwB,EAA/E,CALuB,CAOvB;;AACAf,aAAO,CAACiC,IAAR,CAAa,iBAAb,EAAgC;AAAEC,cAAM,EAAEF;AAAV,OAAhC,EAAwDZ,IAAxD,CAA6De,QAAO,IAAK;AACvE,YAAIA,QAAQ,CAAC/B,IAAT,CAAcgC,OAAlB,EAA2B;AACzB;AACA,eAAK/B,YAAL,GAAoB,IAApB;AACF,SAHA,MAGO;AACL,eAAKgC,QAAL,CAAcC,KAAd,CAAoBH,QAAQ,CAAC/B,IAAT,CAAcmC,OAAlC;AACF;AACD,OAPD,EAOGC,KAPH,CAOSF,KAAI,IAAK;AAChBhB,eAAO,CAACgB,KAAR,CAAc,UAAd,EAA0BA,KAA1B;AACA,aAAKD,QAAL,CAAcC,KAAd,CAAoB,eAApB;AACD,OAVD;AAWD,KA9BM;;AA+BPG,eAAW,GAAG;AACZ;AACAzC,aAAO,CAACiC,IAAR,CAAa,kBAAb,EAAiC;AAAEM,eAAO,EAAE,KAAKhC;AAAhB,OAAjC,EAA+Da,IAA/D,CAAoEe,QAAO,IAAK;AAC9E;AACA,aAAK7B,YAAL,CAAkBoC,IAAlB,CAAuB,KAAKnC,UAA5B,EAF8E,CAG9E;;AACA,aAAKA,UAAL,GAAkB,EAAlB;AACD,OALD,EAKGiC,KALH,CAKSF,KAAI,IAAK;AAChBhB,eAAO,CAACgB,KAAR,CAAc,SAAd,EAAyBA,KAAzB;AACD,OAPD;AAQD,KAzCM;;AA0CPK,mBAAe,GAAG;AAChB,aAAQZ,SAAD,IAAe;AACpB,eAAO,KAAKlB,cAAL,CAAoB+B,QAApB,CAA6Bb,SAA7B,CAAP;AACF,OAFA;AAGF;;AA9CO;AA7BI,CAAf","names":["request","mounted","getOnlineUsers","setInterval","data","showChatRoom","chatMessages","newMessage","props","teacherInfo","type","Array","default","onlineUserList","computed","currentTeacherJobNumber","sessionStorage","getItem","methods","get","then","res","console","log","list","close","$emit","handleButtonClick","index","selectedTeacher","selectedTeacherJobNumber","jobNumber","chatRoomId","post","roomId","response","success","$message","error","message","catch","sendMessage","push","isTeacherOnline","includes"],"sourceRoot":"","sources":["D:\\大学\\大三\\大三春\\数据库\\My-CourseChoose\\Course-Choose\\frontend-platform\\src\\views\\TeacherInfoPopup.vue"],"sourcesContent":["<template>\r\n  <div class=\"popup\">\r\n    <div class=\"popup-content\">\r\n      <h2 class=\"popup-title\">教师信息</h2>\r\n      <table class=\"teacher-table\" border=\"1\">\r\n        <thead>\r\n        <tr>\r\n          <th>序号</th>\r\n          <th>Job Number</th>\r\n          <th>操作</th>\r\n          <th>在线情况</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"(teacher, index) in teacherInfo\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ teacher.jobNumber }}</td>\r\n          <td>\r\n            <button v-if=\"currentTeacherJobNumber !== teacher.jobNumber\" @click=\"handleButtonClick(index)\">聊天</button>\r\n          </td>\r\n          <td>\r\n            <span v-if=\"isTeacherOnline(teacher.jobNumber) || currentTeacherJobNumber === teacher.jobNumber\">在线</span>\r\n            <span v-else>离线</span>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n      <button class=\"close-btn\" @click=\"close\">关闭</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\n\r\nexport default {\r\n  mounted() {\r\n    this.getOnlineUsers();\r\n    setInterval(() => {\r\n      this.getOnlineUsers();\r\n    }, 5000);\r\n  },\r\n  data() {\r\n    return {\r\n      showChatRoom: false, // 控制聊天界面显示\r\n      chatMessages: [], // 存储聊天消息\r\n      newMessage: '', // 输入的新消息\r\n    };\r\n  },\r\n  props: {\r\n    teacherInfo: {//这里存储了当前登录的老师工号，可以从中获取，开启聊天功能\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    onlineUserList: {\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  computed: {\r\n    currentTeacherJobNumber() {\r\n      return sessionStorage.getItem(\"currentId\");\r\n    }\r\n  },\r\n  methods: {\r\n    getOnlineUsers(){\r\n      request.get(\"/course/onlineUsers\").then(res => {\r\n        console.log(res)\r\n        this.onlineUserList = res.data.list;\r\n      })\r\n    },\r\n    close() {\r\n      this.$emit('close');\r\n    },\r\n// 处理按钮点击事件\r\n    handleButtonClick(index) {\r\n      const selectedTeacher = this.teacherInfo[index];\r\n      const selectedTeacherJobNumber = selectedTeacher.jobNumber;\r\n\r\n      // 确定聊天室的唯一标识\r\n      const chatRoomId = `${selectedTeacherJobNumber}-${this.currentTeacherJobNumber}`;\r\n\r\n      // 发送创建聊天室的请求\r\n      request.post(\"/createChatRoom\", { roomId: chatRoomId }).then(response => {\r\n        if (response.data.success) {\r\n          // 显示聊天界面\r\n          this.showChatRoom = true;\r\n        } else {\r\n          this.$message.error(response.data.message);\r\n        }\r\n      }).catch(error => {\r\n        console.error(\"创建聊天室失败：\", error);\r\n        this.$message.error(\"创建聊天室失败，请稍后重试\");\r\n      });\r\n    },\r\n    sendMessage() {\r\n      // 发送消息到后端\r\n      request.post(\"/sendChatMessage\", { message: this.newMessage }).then(response => {\r\n        // 发送成功后，将消息添加到消息列表中\r\n        this.chatMessages.push(this.newMessage);\r\n        // 清空输入框\r\n        this.newMessage = '';\r\n      }).catch(error => {\r\n        console.error(\"发送消息失败：\", error);\r\n      });\r\n    },\r\n    isTeacherOnline() {\r\n      return (jobNumber) => {\r\n        return this.onlineUserList.includes(jobNumber);\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.popup {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.popup-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 5px;\r\n  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.popup-title {\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.teacher-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.teacher-table th,\r\n.teacher-table td {\r\n  padding: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.teacher-table th {\r\n  background-color: #f2f2f2;\r\n}\r\n\r\n.close-btn {\r\n  display: block;\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.close-btn:hover {\r\n  background-color: #0056b3;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}