AAAV,SAAzC,CAAvB;AACApC,eAAO,CAACC,GAAR,CAAYoC,QAAZ;;AAEA,YAAIA,QAAQ,CAAC/B,IAAT,CAAckC,OAAlB,EAA2B;AACzB;AACA;AACAxC,iBAAO,CAACC,GAAR,CAAY,OAAZ,EAAqBoC,QAAQ,CAAC/B,IAAT,CAAckC,OAAnC;AACA,eAAKV,QAAL,CAAcrB,KAAd,CAAoB4B,QAAQ,CAAC/B,IAAT,CAAckC,OAAd,IAAyB,eAA7C;AACF,SALA,MAKO;AACL;AACAxC,iBAAO,CAACC,GAAR,CAAY,SAAZ;AACA,eAAKS,YAAL,GAAoB,IAApB;AACF;AACF,OAnBA,CAmBE,OAAOD,KAAP,EAAc;AACd;AACAT,eAAO,CAACC,GAAR,CAAY,WAAZ,EAAyBQ,KAAK,CAAC4B,QAAN,CAAeI,MAAxC;AACAzC,eAAO,CAACS,KAAR,CAAc,UAAd,EAA0BA,KAA1B;AACA,aAAKqB,QAAL,CAAcrB,KAAd,CAAoB,kBAApB;AACF;;AACAT,aAAO,CAACC,GAAR,CAAY,KAAKS,YAAjB;AACD,KAnDM;;AAoDPgC,eAAW,GAAG;AACZ;AACA,UAAI,CAAC,KAAK/B,UAAV,EAAsB;AACpB,aAAKmB,QAAL,CAAca,OAAd,CAAsB,QAAtB;AACA;AACF,OALY,CAOZ;;;AACA,YAAMrC,IAAG,GAAI;AACXkC,eAAO,EAAE,KAAK7B;AADH,OAAb,CARY,CAYZ;;AACAnB,aAAO,CAAC8C,IAAR,CAAc,yBAAwB,KAAK1B,UAAW,EAAtD,EAAyDN,IAAzD,EACKkB,IADL,CACUa,QAAO,IAAK;AAChB;AACArC,eAAO,CAACC,GAAR,CAAY,QAAZ,EAAsBoC,QAAtB,EAFgB,CAIhB;;AACA,aAAK1B,UAAL,GAAkB,EAAlB,CALgB,CAOhB;AACD,OATL,EAUKiC,KAVL,CAUWnC,KAAI,IAAK;AACd;AACAT,eAAO,CAACS,KAAR,CAAc,QAAd,EAAwBA,KAAxB;AACA,aAAKqB,QAAL,CAAcrB,KAAd,CAAoB,cAApB;AACD,OAdL;AAeD,KAhFM;;AAkFPoC,mBAAe,GAAG;AAChB,aAAQV,SAAD,IAAe;AACpB,eAAO,KAAKjB,cAAL,CAAoB4B,QAApB,CAA6BX,SAA7B,CAAP;AACF,OAFA;AAGF;;AAtFO;AAtDI,CAAf","names":["request","mounted","getOnlineUsers","setInterval","websocket","WebSocket","currentTeacherJobNumber","onopen","console","log","onmessage","event","chatMessages","push","data","onclose","onerror","error","showChatRoom","newMessage","chatRommId","props","teacherInfo","type","Array","default","onlineUserList","computed","sessionStorage","getItem","methods","get","then","res","list","close","$emit","delete","$message","handleButtonClick","index","selectedTeacher","selectedTeacherJobNumber","jobNumber","chatRoomId","response","post","roomId","message","status","sendMessage","warning","catch","isTeacherOnline","includes"],"sourceRoot":"","sources":["D:\\大学\\大三\\大三春\\数据库\\My-CourseChoose\\Course-Choose\\frontend-platform\\src\\views\\TeacherInfoPopup.vue"],"sourcesContent":["<template>\r\n  <div class=\"popup\">\r\n    <div class=\"popup-content\">\r\n      <h2 class=\"popup-title\">教师信息</h2>\r\n      <table class=\"teacher-table\" border=\"1\">\r\n        <thead>\r\n        <tr>\r\n          <th>序号</th>\r\n          <th>Job Number</th>\r\n          <th>操作</th>\r\n          <th>在线情况</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"(teacher, index) in teacherInfo\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ teacher.jobNumber }}</td>\r\n          <td>\r\n            <button v-if=\"currentTeacherJobNumber !== teacher.jobNumber\" @click=\"handleButtonClick(index)\">聊天</button>\r\n          </td>\r\n          <td>\r\n            <span v-if=\"isTeacherOnline(teacher.jobNumber) || currentTeacherJobNumber === teacher.jobNumber\">在线</span>\r\n            <span v-else>离线</span>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n      <button class=\"close-btn\" @click=\"close\">关闭</button>\r\n    </div>\r\n\r\n    <!-- 聊天界面部分 -->\r\n    <div v-if=\"showChatRoom\" class=\"chat-room\">\r\n      <div class=\"message-list\">\r\n        <div v-for=\"(message, index) in chatMessages\" :key=\"index\" class=\"message\">{{ message }}</div>\r\n      </div>\r\n      <div class=\"input-box\">\r\n        <input type=\"text\" v-model=\"newMessage\" placeholder=\"输入消息...\">\r\n        <button @click=\"sendMessage\">发送</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\n\r\nexport default {\r\n  mounted() {\r\n    this.getOnlineUsers();\r\n    setInterval(() => {\r\n      this.getOnlineUsers();\r\n    }, 5000);\r\n\r\n    // 创建 WebSocket 连接\r\n    this.websocket = new WebSocket('ws://localhost:9090/websocket/'+this.currentTeacherJobNumber);\r\n\r\n    // 监听 WebSocket 连接打开事件\r\n    this.websocket.onopen = () => {\r\n      console.log('WebSocket 连接已打开');\r\n    };\r\n\r\n    // 监听 WebSocket 收到消息事件\r\n    this.websocket.onmessage = (event) => {\r\n      this.chatMessages.push(event.data);\r\n    };\r\n\r\n    // 监听 WebSocket 连接关闭事件\r\n    this.websocket.onclose = () => {\r\n      console.log('WebSocket 连接已关闭');\r\n    };\r\n\r\n    // 监听 WebSocket 连接发生错误事件\r\n    this.websocket.onerror = (error) => {\r\n      console.error('WebSocket 连接发生错误:', error);\r\n    };\r\n  },\r\n  data() {\r\n    return {\r\n      showChatRoom: false, // 控制聊天界面显示\r\n      chatMessages: [], // 存储聊天消息\r\n      newMessage: '', // 输入的新消息\r\n      websocket: null, // WebSocket 对象\r\n      chatRommId:''\r\n    };\r\n  },\r\n  props: {\r\n    teacherInfo: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    onlineUserList: {\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  computed: {\r\n    currentTeacherJobNumber() {\r\n      return sessionStorage.getItem(\"currentId\");\r\n    }\r\n  },\r\n  methods: {\r\n    getOnlineUsers(){\r\n      request.get(\"/course/onlineUsers\").then(res => {\r\n        console.log(res)\r\n        this.onlineUserList = res.data.list;\r\n      })\r\n    },\r\n    async close() {\r\n      console.log(\"关闭聊天室\");\r\n      console.log(\"当前聊天室名为：\"+this.chatRommId);\r\n      if (this.chatRommId === '') {\r\n        this.$emit('close');\r\n        return;\r\n      }//如果空，那么直接关闭\r\n      try {\r\n        // 发送请求给后端，请求删除对应的 roomId\r\n        await request.delete(`/chatRoom/${this.chatRommId}`);\r\n        // 触发 close 事件\r\n        this.$emit('close');\r\n      } catch (error) {\r\n        console.error(\"删除聊天室失败：\", error);\r\n        this.$message.error(\"删除聊天室失败，请稍后重试\");\r\n      }\r\n    },\r\n    async handleButtonClick(index) {\r\n      try {\r\n        const selectedTeacher = this.teacherInfo[index];\r\n        const selectedTeacherJobNumber = selectedTeacher.jobNumber;\r\n        const chatRoomId = `${selectedTeacherJobNumber}-${this.currentTeacherJobNumber}`;\r\n        this.chatRommId=chatRoomId;\r\n\r\n        const response = await request.post(\"/chatRoom/createChatRoom\", { roomId: chatRoomId });\r\n        console.log(response);\r\n\r\n        if (response.data.message) {\r\n          // || response.data.message !== \"聊天室已存在\"\r\n          // 如果后端返回了消息，表示请求失败，显示错误消息\r\n          console.log(\"请求失败：\", response.data.message);\r\n          this.$message.error(response.data.message || \"创建聊天室失败，请稍后重试\");\r\n        } else {\r\n          // 否则，请求成功，可以显示聊天界面\r\n          console.log(\"聊天室创建成功\");\r\n          this.showChatRoom = true;\r\n        }\r\n      } catch (error) {\r\n        // 请求失败，显示默认错误消息\r\n        console.log(\"实际返回的状态码：\", error.response.status);\r\n        console.error(\"创建聊天室失败：\", error);\r\n        this.$message.error(\"创建聊天室失败，请稍后重试!!!\");\r\n      }\r\n      console.log(this.showChatRoom);\r\n    },\r\n    sendMessage() {\r\n      // 确保消息不为空\r\n      if (!this.newMessage) {\r\n        this.$message.warning(\"消息不能为空\");\r\n        return;\r\n      }\r\n\r\n      // 构造要发送的数据对象\r\n      const data = {\r\n        message: this.newMessage\r\n      };\r\n\r\n      // 发送 HTTP POST 请求到后端\r\n      request.post(`/chatRoom/sendMessage/${this.chatRommId}`, data)\r\n          .then(response => {\r\n            // 请求成功，可以根据需要处理后端返回的响应\r\n            console.log(\"消息发送成功\", response);\r\n            \r\n            // 清空输入框\r\n            this.newMessage = '';\r\n\r\n            // 更新页面上的内容或者执行其他操作\r\n          })\r\n          .catch(error => {\r\n            // 请求失败，显示错误消息\r\n            console.error(\"消息发送失败\", error);\r\n            this.$message.error(\"消息发送失败，请稍后重试\");\r\n          });\r\n    },\r\n\r\n    isTeacherOnline() {\r\n      return (jobNumber) => {\r\n        return this.onlineUserList.includes(jobNumber);\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.popup {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.popup-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 5px;\r\n  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.popup-title {\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.teacher-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.teacher-table th,\r\n.teacher-table td {\r\n  padding: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.teacher-table th {\r\n  background-color: #f2f2f2;\r\n}\r\n\r\n.close-btn {\r\n  display: block;\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.close-btn:hover {\r\n  background-color: #0056b3;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}