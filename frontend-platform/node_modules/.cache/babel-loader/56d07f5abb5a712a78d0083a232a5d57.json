{"ast":null,"code":"import request from \"@/utils/request\";\nexport default {\n  mounted() {\n    this.getOnlineUsers();\n    setInterval(() => {\n      this.getOnlineUsers();\n    }, 5000); // 创建 WebSocket 连接\n\n    this.websocket = new WebSocket('ws://localhost:9090/websocket/' + this.currentTeacherJobNumber); // 监听 WebSocket 连接打开事件\n\n    this.websocket.onopen = () => {\n      console.log('WebSocket 连接已打开');\n    }; // 监听 WebSocket 收到消息事件\n\n\n    this.websocket.onmessage = event => {\n      this.chatMessages.push(event.data);\n    }; // 监听 WebSocket 连接关闭事件\n\n\n    this.websocket.onclose = () => {\n      console.log('WebSocket 连接已关闭');\n    }; // 监听 WebSocket 连接发生错误事件\n\n\n    this.websocket.onerror = error => {\n      console.error('WebSocket 连接发生错误:', error);\n    };\n  },\n\n  data() {\n    return {\n      showChatRoom: false,\n      // 控制聊天界面显示\n      chatMessages: [],\n      // 存储聊天消息\n      newMessage: '',\n      // 输入的新消息\n      websocket: null // WebSocket 对象\n\n    };\n  },\n\n  props: {\n    teacherInfo: {\n      type: Array,\n      default: () => []\n    },\n    onlineUserList: {\n      type: Array,\n      default: () => []\n    }\n  },\n  computed: {\n    currentTeacherJobNumber() {\n      return sessionStorage.getItem(\"currentId\");\n    }\n\n  },\n  methods: {\n    getOnlineUsers() {\n      request.get(\"/course/onlineUsers\").then(res => {\n        console.log(res);\n        this.onlineUserList = res.data.list;\n      });\n    },\n\n    close() {\n      this.$emit('close');\n    },\n\n    async handleButtonClick(index) {\n      try {\n        const selectedTeacher = this.teacherInfo[index];\n        const selectedTeacherJobNumber = selectedTeacher.jobNumber;\n        const chatRoomId = `${selectedTeacherJobNumber}-${this.currentTeacherJobNumber}`;\n        const response = await request.post(\"/chatRoom/createChatRoom\", {\n          roomId: chatRoomId\n        });\n        console.log(response);\n\n        if (response.data.message && response.data.message !== \"聊天室已存在\") {\n          // 如果后端返回了消息，表示请求失败，显示错误消息\n          console.log(\"请求失败：\", response.data.message);\n          this.$message.error(response.data.message || \"创建聊天室失败，请稍后重试\");\n        } else {\n          // 否则，请求成功，可以显示聊天界面\n          console.log(\"聊天室创建成功\");\n          this.showChatRoom = true;\n        }\n      } catch (error) {\n        // 请求失败，显示默认错误消息\n        console.log(\"实际返回的状态码：\", error.response.status);\n        console.error(\"创建聊天室失败：\", error);\n        this.$message.error(\"创建聊天室失败，请稍后重试!!!\");\n      }\n\n      console.log(this.showChatRoom);\n    },\n\n    sendMessage() {\n      // 使用 WebSocket 发送消息到后端\n      this.websocket.send(this.newMessage); // 发送成功后，将消息添加到消息列表中\n\n      this.chatMessages.push(this.newMessage); // 清空输入框\n\n      this.newMessage = '';\n    },\n\n    isTeacherOnline() {\n      return jobNumber => {\n        return this.onlineUserList.includes(jobNumber);\n      };\n    }\n\n  }\n};","map":{"version":3,"mappings":"AA4CA,OAAOA,OAAP,MAAoB,iBAApB;AAEA,eAAe;AACbC,SAAO,GAAG;AACR,SAAKC,cAAL;AACAC,eAAW,CAAC,MAAM;AAChB,WAAKD,cAAL;AACD,KAFU,EAER,IAFQ,CAAX,CAFQ,CAMR;;AACA,SAAKE,SAAL,GAAiB,IAAIC,SAAJ,CAAc,mCAAiC,KAAKC,uBAApD,CAAjB,CAPQ,CASR;;AACA,SAAKF,SAAL,CAAeG,MAAf,GAAwB,MAAM;AAC5BC,aAAO,CAACC,GAAR,CAAY,iBAAZ;AACD,KAFD,CAVQ,CAcR;;;AACA,SAAKL,SAAL,CAAeM,SAAf,GAA4BC,KAAD,IAAW;AACpC,WAAKC,YAAL,CAAkBC,IAAlB,CAAuBF,KAAK,CAACG,IAA7B;AACD,KAFD,CAfQ,CAmBR;;;AACA,SAAKV,SAAL,CAAeW,OAAf,GAAyB,MAAM;AAC7BP,aAAO,CAACC,GAAR,CAAY,iBAAZ;AACD,KAFD,CApBQ,CAwBR;;;AACA,SAAKL,SAAL,CAAeY,OAAf,GAA0BC,KAAD,IAAW;AAClCT,aAAO,CAACS,KAAR,CAAc,mBAAd,EAAmCA,KAAnC;AACD,KAFD;AAGD,GA7BY;;AA8BbH,MAAI,GAAG;AACL,WAAO;AACLI,kBAAY,EAAE,KADT;AACgB;AACrBN,kBAAY,EAAE,EAFT;AAEa;AAClBO,gBAAU,EAAE,EAHP;AAGW;AAChBf,eAAS,EAAE,IAJN,CAIW;;AAJX,KAAP;AAMD,GArCY;;AAsCbgB,OAAK,EAAE;AACLC,eAAW,EAAE;AACXC,UAAI,EAAEC,KADK;AAEXC,aAAO,EAAE,MAAM;AAFJ,KADR;AAKLC,kBAAc,EAAE;AACdH,UAAI,EAAEC,KADQ;AAEdC,aAAO,EAAE,MAAM;AAFD;AALX,GAtCM;AAgDbE,UAAQ,EAAE;AACRpB,2BAAuB,GAAG;AACxB,aAAOqB,cAAc,CAACC,OAAf,CAAuB,WAAvB,CAAP;AACF;;AAHQ,GAhDG;AAqDbC,SAAO,EAAE;AACP3B,kBAAc,GAAE;AACdF,aAAO,CAAC8B,GAAR,CAAY,qBAAZ,EAAmCC,IAAnC,CAAwCC,GAAE,IAAK;AAC7CxB,eAAO,CAACC,GAAR,CAAYuB,GAAZ;AACA,aAAKP,cAAL,GAAsBO,GAAG,CAAClB,IAAJ,CAASmB,IAA/B;AACD,OAHD;AAID,KANM;;AAOPC,SAAK,GAAG;AACN,WAAKC,KAAL,CAAW,OAAX;AACD,KATM;;AAUP,UAAMC,iBAAN,CAAwBC,KAAxB,EAA+B;AAC7B,UAAI;AACF,cAAMC,eAAc,GAAI,KAAKjB,WAAL,CAAiBgB,KAAjB,CAAxB;AACA,cAAME,wBAAuB,GAAID,eAAe,CAACE,SAAjD;AACA,cAAMC,UAAS,GAAK,GAAEF,wBAAyB,IAAG,KAAKjC,uBAAwB,EAA/E;AAEA,cAAMoC,QAAO,GAAI,MAAM1C,OAAO,CAAC2C,IAAR,CAAa,0BAAb,EAAyC;AAAEC,gBAAM,EAAEH;AAAV,SAAzC,CAAvB;AACAjC,eAAO,CAACC,GAAR,CAAYiC,QAAZ;;AAEA,YAAIA,QAAQ,CAAC5B,IAAT,CAAc+B,OAAd,IAAuBH,QAAQ,CAAC5B,IAAT,CAAc+B,OAAd,KAA0B,QAArD,EAA+D;AAC7D;AACArC,iBAAO,CAACC,GAAR,CAAY,OAAZ,EAAqBiC,QAAQ,CAAC5B,IAAT,CAAc+B,OAAnC;AACA,eAAKC,QAAL,CAAc7B,KAAd,CAAoByB,QAAQ,CAAC5B,IAAT,CAAc+B,OAAd,IAAyB,eAA7C;AACF,SAJA,MAIO;AACL;AACArC,iBAAO,CAACC,GAAR,CAAY,SAAZ;AACA,eAAKS,YAAL,GAAoB,IAApB;AACF;AACF,OAjBA,CAiBE,OAAOD,KAAP,EAAc;AACd;AACAT,eAAO,CAACC,GAAR,CAAY,WAAZ,EAAyBQ,KAAK,CAACyB,QAAN,CAAeK,MAAxC;AACAvC,eAAO,CAACS,KAAR,CAAc,UAAd,EAA0BA,KAA1B;AACA,aAAK6B,QAAL,CAAc7B,KAAd,CAAoB,kBAApB;AACF;;AACAT,aAAO,CAACC,GAAR,CAAY,KAAKS,YAAjB;AACD,KAnCM;;AAoCP8B,eAAW,GAAG;AACZ;AACA,WAAK5C,SAAL,CAAe6C,IAAf,CAAoB,KAAK9B,UAAzB,EAFY,CAGZ;;AACA,WAAKP,YAAL,CAAkBC,IAAlB,CAAuB,KAAKM,UAA5B,EAJY,CAKZ;;AACA,WAAKA,UAAL,GAAkB,EAAlB;AACD,KA3CM;;AA4CP+B,mBAAe,GAAG;AAChB,aAAQV,SAAD,IAAe;AACpB,eAAO,KAAKf,cAAL,CAAoB0B,QAApB,CAA6BX,SAA7B,CAAP;AACF,OAFA;AAGF;;AAhDO;AArDI,CAAf","names":["request","mounted","getOnlineUsers","setInterval","websocket","WebSocket","currentTeacherJobNumber","onopen","console","log","onmessage","event","chatMessages","push","data","onclose","onerror","error","showChatRoom","newMessage","props","teacherInfo","type","Array","default","onlineUserList","computed","sessionStorage","getItem","methods","get","then","res","list","close","$emit","handleButtonClick","index","selectedTeacher","selectedTeacherJobNumber","jobNumber","chatRoomId","response","post","roomId","message","$message","status","sendMessage","send","isTeacherOnline","includes"],"sourceRoot":"","sources":["D:\\大学\\大三\\大三春\\数据库\\My-CourseChoose\\Course-Choose\\frontend-platform\\src\\views\\TeacherInfoPopup.vue"],"sourcesContent":["<template>\r\n  <div class=\"popup\">\r\n    <div class=\"popup-content\">\r\n      <h2 class=\"popup-title\">教师信息</h2>\r\n      <table class=\"teacher-table\" border=\"1\">\r\n        <thead>\r\n        <tr>\r\n          <th>序号</th>\r\n          <th>Job Number</th>\r\n          <th>操作</th>\r\n          <th>在线情况</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"(teacher, index) in teacherInfo\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ teacher.jobNumber }}</td>\r\n          <td>\r\n            <button v-if=\"currentTeacherJobNumber !== teacher.jobNumber\" @click=\"handleButtonClick(index)\">聊天</button>\r\n          </td>\r\n          <td>\r\n            <span v-if=\"isTeacherOnline(teacher.jobNumber) || currentTeacherJobNumber === teacher.jobNumber\">在线</span>\r\n            <span v-else>离线</span>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n      <button class=\"close-btn\" @click=\"close\">关闭</button>\r\n    </div>\r\n\r\n    <!-- 聊天界面部分 -->\r\n    <div v-if=\"showChatRoom\" class=\"chat-room\">\r\n      <div class=\"message-list\">\r\n        <div v-for=\"(message, index) in chatMessages\" :key=\"index\" class=\"message\">{{ message }}</div>\r\n      </div>\r\n      <div class=\"input-box\">\r\n        <input type=\"text\" v-model=\"newMessage\" placeholder=\"输入消息...\">\r\n        <button @click=\"sendMessage\">发送</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\n\r\nexport default {\r\n  mounted() {\r\n    this.getOnlineUsers();\r\n    setInterval(() => {\r\n      this.getOnlineUsers();\r\n    }, 5000);\r\n\r\n    // 创建 WebSocket 连接\r\n    this.websocket = new WebSocket('ws://localhost:9090/websocket/'+this.currentTeacherJobNumber);\r\n\r\n    // 监听 WebSocket 连接打开事件\r\n    this.websocket.onopen = () => {\r\n      console.log('WebSocket 连接已打开');\r\n    };\r\n\r\n    // 监听 WebSocket 收到消息事件\r\n    this.websocket.onmessage = (event) => {\r\n      this.chatMessages.push(event.data);\r\n    };\r\n\r\n    // 监听 WebSocket 连接关闭事件\r\n    this.websocket.onclose = () => {\r\n      console.log('WebSocket 连接已关闭');\r\n    };\r\n\r\n    // 监听 WebSocket 连接发生错误事件\r\n    this.websocket.onerror = (error) => {\r\n      console.error('WebSocket 连接发生错误:', error);\r\n    };\r\n  },\r\n  data() {\r\n    return {\r\n      showChatRoom: false, // 控制聊天界面显示\r\n      chatMessages: [], // 存储聊天消息\r\n      newMessage: '', // 输入的新消息\r\n      websocket: null // WebSocket 对象\r\n    };\r\n  },\r\n  props: {\r\n    teacherInfo: {\r\n      type: Array,\r\n      default: () => []\r\n    },\r\n    onlineUserList: {\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  computed: {\r\n    currentTeacherJobNumber() {\r\n      return sessionStorage.getItem(\"currentId\");\r\n    }\r\n  },\r\n  methods: {\r\n    getOnlineUsers(){\r\n      request.get(\"/course/onlineUsers\").then(res => {\r\n        console.log(res)\r\n        this.onlineUserList = res.data.list;\r\n      })\r\n    },\r\n    close() {\r\n      this.$emit('close');\r\n    },\r\n    async handleButtonClick(index) {\r\n      try {\r\n        const selectedTeacher = this.teacherInfo[index];\r\n        const selectedTeacherJobNumber = selectedTeacher.jobNumber;\r\n        const chatRoomId = `${selectedTeacherJobNumber}-${this.currentTeacherJobNumber}`;\r\n\r\n        const response = await request.post(\"/chatRoom/createChatRoom\", { roomId: chatRoomId });\r\n        console.log(response);\r\n\r\n        if (response.data.message&&response.data.message !== \"聊天室已存在\") {\r\n          // 如果后端返回了消息，表示请求失败，显示错误消息\r\n          console.log(\"请求失败：\", response.data.message);\r\n          this.$message.error(response.data.message || \"创建聊天室失败，请稍后重试\");\r\n        } else {\r\n          // 否则，请求成功，可以显示聊天界面\r\n          console.log(\"聊天室创建成功\");\r\n          this.showChatRoom = true;\r\n        }\r\n      } catch (error) {\r\n        // 请求失败，显示默认错误消息\r\n        console.log(\"实际返回的状态码：\", error.response.status);\r\n        console.error(\"创建聊天室失败：\", error);\r\n        this.$message.error(\"创建聊天室失败，请稍后重试!!!\");\r\n      }\r\n      console.log(this.showChatRoom);\r\n    },\r\n    sendMessage() {\r\n      // 使用 WebSocket 发送消息到后端\r\n      this.websocket.send(this.newMessage);\r\n      // 发送成功后，将消息添加到消息列表中\r\n      this.chatMessages.push(this.newMessage);\r\n      // 清空输入框\r\n      this.newMessage = '';\r\n    },\r\n    isTeacherOnline() {\r\n      return (jobNumber) => {\r\n        return this.onlineUserList.includes(jobNumber);\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.popup {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.popup-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 5px;\r\n  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.popup-title {\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.teacher-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.teacher-table th,\r\n.teacher-table td {\r\n  padding: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.teacher-table th {\r\n  background-color: #f2f2f2;\r\n}\r\n\r\n.close-btn {\r\n  display: block;\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.close-btn:hover {\r\n  background-color: #0056b3;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}