{"ast":null,"code":"import { Avatar, Lock } from '@element-plus/icons-vue';\nimport request from \"@/utils/request\";\nexport default {\n  name: \"Login\",\n\n  data() {\n    return {\n      Avatar,\n      Lock,\n      bg: {\n        backgroundImage: \"url(\" + require(\"../assets/tushu.jpg\") + \")\",\n        backgroundRepeat: 'no-repeat',\n        backgroundSize: \"cover\",\n        minHeight: \"calc(100vh - 1000px)\",\n        position: \"relative\",\n        backgroundPosition: \"center center\"\n      },\n      form: {},\n      rules: {\n        id: [{\n          required: true,\n          message: '请输入学号/工号',\n          trigger: 'blur'\n        }],\n        password: [{\n          required: true,\n          message: '请输入密码',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n\n  methods: {\n    login() {\n      this.$refs['form'].validate(valid => {\n        if (valid) {\n          if (this.form.id.length == 5) {\n            // 教师或管理员登录\n            request.post(\"/teacher/login\", this.form).then(res => {\n              if (res.code === '0') {\n                this.$message({\n                  type: \"success\",\n                  message: \"登录成功\"\n                });\n                sessionStorage.setItem(\"currentId\", res.data.id);\n                sessionStorage.setItem(\"currentName\", res.data.name);\n\n                if (this.form.id == \"100\") {\n                  sessionStorage.setItem(\"currentDep\", 0);\n                  sessionStorage.setItem(\"currentDepName\", \"\");\n                  this.$router.push(\"/manageCourse\"); // 登录成功之后进行页面跳转\n                } else {\n                  request.get(\"/department/forHeader\", {\n                    params: {\n                      dep: res.data.department\n                    }\n                  }).then(res2 => {\n                    sessionStorage.setItem(\"currentDepName\", \"你好，\" + res2.data[0].departmentName + \"，\");\n                  });\n                  sessionStorage.setItem(\"currentDep\", res.data.department);\n                  this.$router.push(\"/teacher\");\n                }\n              } else {\n                this.$message({\n                  type: \"error\",\n                  message: \"输入密码错误或账户不对!\"\n                });\n              }\n            });\n          } else {\n            this.$message({\n              type: \"error\",\n              message: \"用户名不合法\" + this.form.id\n            });\n          }\n        }\n      }); //console.log(this.form.id);\n    }\n\n  }\n}; // 注意，登录后sessionShort存储情况如下：\n// key=currentId,value=学号/工号\n// key=currentName,value=姓名\n// key=currentDep,value=院系号，管理员为0\n// key=currentDepName,value=\"你好，xxx学院，某某\"，管理员为空字符串","map":{"version":3,"mappings":"AAyBA,SAAQA,MAAR,EAAgBC,IAAhB,QAA2B,yBAA3B;AACA,OAAOC,OAAP,MAAoB,iBAApB;AAEA,eAAe;AACbC,MAAI,EAAE,OADO;;AAEbC,MAAI,GAAG;AACL,WAAO;AACLJ,YADK;AAELC,UAFK;AAGLI,QAAE,EAAE;AACFC,uBAAe,EAAE,SAASC,OAAO,CAAC,qBAAD,CAAhB,GAA0C,GADzD;AAEFC,wBAAgB,EAAE,WAFhB;AAGFC,sBAAc,EAAE,OAHd;AAIFC,iBAAS,EAAE,sBAJT;AAKFC,gBAAQ,EAAE,UALR;AAMFC,0BAAkB,EAAE;AANlB,OAHC;AAWLC,UAAI,EAAE,EAXD;AAYLC,WAAK,EAAE;AACLC,UAAE,EAAE,CACF;AAACC,kBAAQ,EAAE,IAAX;AAAiBC,iBAAO,EAAE,UAA1B;AAAsCC,iBAAO,EAAE;AAA/C,SADE,CADC;AAILC,gBAAQ,EAAE,CACR;AAACH,kBAAQ,EAAE,IAAX;AAAiBC,iBAAO,EAAE,OAA1B;AAAmCC,iBAAO,EAAE;AAA5C,SADQ;AAJL;AAZF,KAAP;AAqBD,GAxBY;;AAyBbE,SAAO,EAAE;AACPC,SAAK,GAAG;AACN,WAAKC,KAAL,CAAW,MAAX,EAAmBC,QAAnB,CAA6BC,KAAD,IAAW;AACrC,YAAIA,KAAJ,EAAW;AACT,cAAI,KAAKX,IAAL,CAAUE,EAAV,CAAaU,MAAb,IAAuB,CAA3B,EAA8B;AAAE;AAC9BvB,mBAAO,CAACwB,IAAR,CAAa,gBAAb,EAA+B,KAAKb,IAApC,EAA0Cc,IAA1C,CAA+CC,GAAE,IAAK;AACpD,kBAAIA,GAAG,CAACC,IAAJ,KAAa,GAAjB,EAAsB;AACpB,qBAAKC,QAAL,CAAc;AACZC,sBAAI,EAAE,SADM;AAEZd,yBAAO,EAAE;AAFG,iBAAd;AAIAe,8BAAc,CAACC,OAAf,CAAuB,WAAvB,EAAoCL,GAAG,CAACxB,IAAJ,CAASW,EAA7C;AACAiB,8BAAc,CAACC,OAAf,CAAuB,aAAvB,EAAsCL,GAAG,CAACxB,IAAJ,CAASD,IAA/C;;AACA,oBAAI,KAAKU,IAAL,CAAUE,EAAV,IAAgB,KAApB,EAA2B;AACzBiB,gCAAc,CAACC,OAAf,CAAuB,YAAvB,EAAqC,CAArC;AACAD,gCAAc,CAACC,OAAf,CAAuB,gBAAvB,EAAyC,EAAzC;AACA,uBAAKC,OAAL,CAAaC,IAAb,CAAkB,eAAlB,EAHyB,CAGW;AACtC,iBAJA,MAIO;AACLjC,yBAAO,CAACkC,GAAR,CAAY,uBAAZ,EAAqC;AACnCC,0BAAM,EAAE;AACNC,yBAAG,EAAEV,GAAG,CAACxB,IAAJ,CAASmC;AADR;AAD2B,mBAArC,EAIGZ,IAJH,CAIQa,IAAG,IAAK;AACdR,kCAAc,CAACC,OAAf,CAAuB,gBAAvB,EAAyC,QAAQO,IAAI,CAACpC,IAAL,CAAU,CAAV,EAAaqC,cAArB,GAAsC,GAA/E;AACD,mBAND;AAOAT,gCAAc,CAACC,OAAf,CAAuB,YAAvB,EAAqCL,GAAG,CAACxB,IAAJ,CAASmC,UAA9C;AACA,uBAAKL,OAAL,CAAaC,IAAb,CAAkB,UAAlB;AACF;AACF,eAtBA,MAsBO;AACL,qBAAKL,QAAL,CAAc;AACZC,sBAAI,EAAE,OADM;AAEZd,yBAAO,EAAE;AAFG,iBAAd;AAIF;AACD,aA7BD;AA8BF,WA/BA,MA+BO;AACL,iBAAKa,QAAL,CAAc;AACZC,kBAAI,EAAE,OADM;AAEZd,qBAAO,EAAE,WAAS,KAAKJ,IAAL,CAAUE;AAFhB,aAAd;AAIF;AACF;AACD,OAxCD,EADM,CA0CN;AACF;;AA5CO;AAzBI,CAAf,C,CAwEA;AACA;AACA;AACA;AACA","names":["Avatar","Lock","request","name","data","bg","backgroundImage","require","backgroundRepeat","backgroundSize","minHeight","position","backgroundPosition","form","rules","id","required","message","trigger","password","methods","login","$refs","validate","valid","length","post","then","res","code","$message","type","sessionStorage","setItem","$router","push","get","params","dep","department","res2","departmentName"],"sourceRoot":"","sources":["D:\\大学\\大三\\大三春\\数据库\\My-CourseChoose\\Course-Choose\\frontend-platform\\src\\views\\Login.vue"],"sourcesContent":["<template>\r\n  <div :style=\"bg\" style=\"overflow: hidden;\">\r\n    <el-form ref=\"form\" :model=\"form\" class=\"login\" :rules=\"rules\">\r\n      <div style=\"color: darkslategrey; font-size: 30px; text-align: center; padding: 40px 0;\">欢迎登录</div>\r\n      <el-form-item prop=\"id\">\r\n        <el-input :prefix-icon=\"Avatar\" placeholder=\"请输入学号/工号\" v-model=\"form.id\"/>\r\n      </el-form-item>\r\n      <el-form-item prop=\"password\">\r\n        <el-input :prefix-icon=\"Lock\" placeholder=\"请输入密码\" v-model=\"form.password\" show-password/>\r\n      </el-form-item>\r\n      <!--      <div style=\"text-align: center;\">-->\r\n      <!--        <el-button style=\"width: 80%;\" type=\"info\" @click=\"login\">登 录</el-button>-->\r\n      <!--        <div style=\"height: 50px; background-color: deepskyblue; width: 80%; margin: 0 auto;\"></div>-->\r\n      <!--      </div>-->\r\n      <el-button style=\"width: 100%;\" type=\"info\" @click=\"login\">登 录</el-button>\r\n    </el-form>\r\n  </div>\r\n  <!--\r\n    元素居中可以通过设置：style=\"margin: 0 auto;\"来实现，但el-button的margin不知为何会失效。\r\n    可以加一个div，设置div的style=\"text-align: center;\"，也可以实现内部元素el-button的居中。\r\n    此处直接设置el-button的width: 100%，没有设置居中，也可以得到理想的效果。\r\n  -->\r\n</template>\r\n\r\n<script>\r\nimport {Avatar, Lock} from '@element-plus/icons-vue';\r\nimport request from \"@/utils/request\";\r\n\r\nexport default {\r\n  name: \"Login\",\r\n  data() {\r\n    return {\r\n      Avatar,\r\n      Lock,\r\n      bg: {\r\n        backgroundImage: \"url(\" + require(\"../assets/tushu.jpg\") + \")\",\r\n        backgroundRepeat: 'no-repeat',\r\n        backgroundSize: \"cover\",\r\n        minHeight: \"calc(100vh - 1000px)\",\r\n        position: \"relative\",\r\n        backgroundPosition: \"center center\",\r\n      },\r\n      form: {},\r\n      rules: {\r\n        id: [\r\n          {required: true, message: '请输入学号/工号', trigger: 'blur'},\r\n        ],\r\n        password: [\r\n          {required: true, message: '请输入密码', trigger: 'blur'},\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    login() {\r\n      this.$refs['form'].validate((valid) => {\r\n        if (valid) {\r\n          if (this.form.id.length == 5) { // 教师或管理员登录\r\n            request.post(\"/teacher/login\", this.form).then(res => {\r\n              if (res.code === '0') {\r\n                this.$message({\r\n                  type: \"success\",\r\n                  message: \"登录成功\"\r\n                })\r\n                sessionStorage.setItem(\"currentId\", res.data.id)\r\n                sessionStorage.setItem(\"currentName\", res.data.name)\r\n                if (this.form.id == \"100\") {\r\n                  sessionStorage.setItem(\"currentDep\", 0);\r\n                  sessionStorage.setItem(\"currentDepName\", \"\")\r\n                  this.$router.push(\"/manageCourse\"); // 登录成功之后进行页面跳转\r\n                } else {\r\n                  request.get(\"/department/forHeader\", {\r\n                    params: {\r\n                      dep: res.data.department\r\n                    }\r\n                  }).then(res2 => {\r\n                    sessionStorage.setItem(\"currentDepName\", \"你好，\" + res2.data[0].departmentName + \"，\")\r\n                  })\r\n                  sessionStorage.setItem(\"currentDep\", res.data.department);\r\n                  this.$router.push(\"/teacher\");\r\n                }\r\n              } else {\r\n                this.$message({\r\n                  type: \"error\",\r\n                  message: \"输入密码错误或账户不对!\"\r\n                })\r\n              }\r\n            })\r\n          } else {\r\n            this.$message({\r\n              type: \"error\",\r\n              message: \"用户名不合法\"+this.form.id\r\n            })\r\n          }\r\n        }\r\n      });\r\n      //console.log(this.form.id);\r\n    }\r\n  }\r\n}\r\n// 注意，登录后sessionShort存储情况如下：\r\n// key=currentId,value=学号/工号\r\n// key=currentName,value=姓名\r\n// key=currentDep,value=院系号，管理员为0\r\n// key=currentDepName,value=\"你好，xxx学院，某某\"，管理员为空字符串\r\n</script>\r\n\r\n<style>\r\n.login {\r\n  background-color: wheat;\r\n  width: 30%;\r\n  height: 320px;\r\n  opacity: 0.6;\r\n  border-radius: 30px;\r\n  margin: 160px auto;\r\n\r\n  /* 为其整体设置接近透明的效果*/\r\n  background-color: rgba(255, 255, 255, 0.3);\r\n  /* 设置box-shadow使其有立体感 */\r\n  box-shadow: 5px 5px 0 0 rgba(0, 0, 0, 0.3);\r\n\r\n  padding: 0 50px;\r\n}\r\n</style>"]},"metadata":{},"sourceType":"module"}