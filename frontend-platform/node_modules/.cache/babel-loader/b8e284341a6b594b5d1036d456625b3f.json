{"ast":null,"code":"import request from \"@/utils/request\";\nexport default {\n  mounted() {\n    this.getOnlineUsers();\n    setInterval(() => {\n      this.getOnlineUsers();\n    }, 5000);\n  },\n\n  data() {\n    return {\n      onlineUserList: []\n    };\n  },\n\n  props: {\n    teacherInfo: {\n      //这里存储了当前登录的老师工号，可以从中获取，开启聊天功能\n      type: Array,\n      default: () => []\n    }\n  },\n  computed: {\n    currentTeacherJobNumber() {\n      return sessionStorage.getItem(\"currentId\");\n    }\n\n  },\n  methods: {\n    getOnlineUsers() {\n      request.get(\"/course/onlineUsers\").then(res => {\n        console.log(res);\n        this.onlineUserList = res.data.list;\n      });\n    },\n\n    close() {\n      this.$emit('close');\n    },\n\n    handleButtonClick(index) {\n      const selectedTeacher = this.teacherInfo[index];\n      /*      console.log(\"现在输出当前在线用户\");\r\n            console.log(this.onlineUserList);*/\n      // 执行按钮点击操作，例如跳转到特定页面等\n\n      /*      if (this.onlineUserList.contains(selectedTeacher.jobNumber)) {\r\n              this.$message.error('不能和自己聊天');\r\n              return;\r\n            }*/\n\n      console.log('按钮点击操作:', selectedTeacher);\n    }\n\n  }\n};","map":{"version":3,"mappings":"AA4BA,OAAOA,OAAP,MAAoB,iBAApB;AAEA,eAAe;AACbC,SAAO,GAAG;AACR,SAAKC,cAAL;AACAC,eAAW,CAAC,MAAM;AAChB,WAAKD,cAAL;AACD,KAFU,EAER,IAFQ,CAAX;AAGD,GANY;;AAObE,MAAI,GAAG;AACL,WAAO;AACLC,oBAAc,EAAE;AADX,KAAP;AAGD,GAXY;;AAYbC,OAAK,EAAE;AACLC,eAAW,EAAE;AAAC;AACZC,UAAI,EAAEC,KADK;AAEXC,aAAO,EAAE,MAAM;AAFJ;AADR,GAZM;AAkBbC,UAAQ,EAAE;AACRC,2BAAuB,GAAG;AACxB,aAAOC,cAAc,CAACC,OAAf,CAAuB,WAAvB,CAAP;AACF;;AAHQ,GAlBG;AAuBbC,SAAO,EAAE;AACPb,kBAAc,GAAE;AACdF,aAAO,CAACgB,GAAR,CAAY,qBAAZ,EAAmCC,IAAnC,CAAwCC,GAAE,IAAK;AAC7CC,eAAO,CAACC,GAAR,CAAYF,GAAZ;AACA,aAAKb,cAAL,GAAsBa,GAAG,CAACd,IAAJ,CAASiB,IAA/B;AACD,OAHD;AAID,KANM;;AAOPC,SAAK,GAAG;AACN,WAAKC,KAAL,CAAW,OAAX;AACD,KATM;;AAUPC,qBAAiB,CAACC,KAAD,EAAQ;AACvB,YAAMC,eAAc,GAAI,KAAKnB,WAAL,CAAiBkB,KAAjB,CAAxB;AACN;;AAEM;;AACN;;;;;AAIMN,aAAO,CAACC,GAAR,CAAY,SAAZ,EAAuBM,eAAvB;AACF;;AApBO;AAvBI,CAAf","names":["request","mounted","getOnlineUsers","setInterval","data","onlineUserList","props","teacherInfo","type","Array","default","computed","currentTeacherJobNumber","sessionStorage","getItem","methods","get","then","res","console","log","list","close","$emit","handleButtonClick","index","selectedTeacher"],"sourceRoot":"","sources":["D:\\大学\\大三\\大三春\\数据库\\My-CourseChoose\\Course-Choose\\frontend-platform\\src\\views\\TeacherInfoPopup.vue"],"sourcesContent":["<template>\r\n  <div class=\"popup\">\r\n    <div class=\"popup-content\">\r\n      <h2 class=\"popup-title\">教师信息</h2>\r\n      <table class=\"teacher-table\" border=\"1\">\r\n        <thead>\r\n        <tr>\r\n          <th>序号</th>\r\n          <th>Job Number</th>\r\n          <th>操作</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"(teacher, index) in teacherInfo\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ teacher.jobNumber }}</td>\r\n          <td>\r\n            <button v-if=\"currentTeacherJobNumber !== teacher.jobNumber\" @click=\"handleButtonClick(index)\">聊天</button>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n      <button class=\"close-btn\" @click=\"close\">关闭</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport request from \"@/utils/request\";\r\n\r\nexport default {\r\n  mounted() {\r\n    this.getOnlineUsers();\r\n    setInterval(() => {\r\n      this.getOnlineUsers();\r\n    }, 5000);\r\n  },\r\n  data() {\r\n    return {\r\n      onlineUserList: []\r\n    }\r\n  },\r\n  props: {\r\n    teacherInfo: {//这里存储了当前登录的老师工号，可以从中获取，开启聊天功能\r\n      type: Array,\r\n      default: () => []\r\n    }\r\n  },\r\n  computed: {\r\n    currentTeacherJobNumber() {\r\n      return sessionStorage.getItem(\"currentId\");\r\n    }\r\n  },\r\n  methods: {\r\n    getOnlineUsers(){\r\n      request.get(\"/course/onlineUsers\").then(res => {\r\n        console.log(res)\r\n        this.onlineUserList = res.data.list;\r\n      })\r\n    },\r\n    close() {\r\n      this.$emit('close');\r\n    },\r\n    handleButtonClick(index) {\r\n      const selectedTeacher = this.teacherInfo[index];\r\n/*      console.log(\"现在输出当前在线用户\");\r\n      console.log(this.onlineUserList);*/\r\n      // 执行按钮点击操作，例如跳转到特定页面等\r\n/*      if (this.onlineUserList.contains(selectedTeacher.jobNumber)) {\r\n        this.$message.error('不能和自己聊天');\r\n        return;\r\n      }*/\r\n      console.log('按钮点击操作:', selectedTeacher);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.popup {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.popup-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 5px;\r\n  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.popup-title {\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.teacher-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.teacher-table th,\r\n.teacher-table td {\r\n  padding: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.teacher-table th {\r\n  background-color: #f2f2f2;\r\n}\r\n\r\n.close-btn {\r\n  display: block;\r\n  margin-top: 20px;\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.close-btn:hover {\r\n  background-color: #0056b3;\r\n}\r\n</style>\r\n"]},"metadata":{},"sourceType":"module"}